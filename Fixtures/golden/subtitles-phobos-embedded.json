{
  "description" : "Phobos: embedded subtitles, proper first then automatic, no loose files",
  "expect" : {
    "arguments" : [
      "--newline",
      "--no-colors",
      "--progress",
      "--progress-template",
      "download:[[PROG]]%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s|%(progress._total_bytes_str)s|%(progress._total_bytes_estimate_str)s|%(info.playlist_index)s|%(info.n_entries)s|%(info.title)s",
      "--ignore-config",
      "--js-runtimes",
      "deno:/tools/deno",
      "--ffmpeg-location",
      "/tools/ffmpeg",
      "--embed-chapters",
      "--write-subs",
      "--write-auto-subs",
      "--sub-langs",
      "en",
      "--sleep-subtitles",
      "2",
      "--embed-subs",
      "--compat-options",
      "no-keep-subs",
      "--embed-metadata",
      "-N",
      "4",
      "-P",
      "/Users/test/Movies/YouTube",
      "-o",
      "%(title).150B [%(id)s].%(ext)s",
      "--no-overwrites",
      "--no-mtime",
      "--",
      "https://www.youtube.com/watch?v=aqz-KE-bpKQ"
    ],
    "display" : "yt-dlp --ignore-config --js-runtimes deno:/tools/deno --ffmpeg-location /tools/ffmpeg --embed-chapters --write-subs --write-auto-subs --sub-langs en --sleep-subtitles 2 --embed-subs --compat-options no-keep-subs --embed-metadata -N 4 -P /Users/test/Movies/YouTube -o '%(title).150B [%(id)s].%(ext)s' --no-overwrites --no-mtime -- 'https://www.youtube.com/watch?v=aqz-KE-bpKQ'"
  },
  "folder" : "/Users/test/Movies/YouTube",
  "links" : [
    "https://www.youtube.com/watch?v=aqz-KE-bpKQ"
  ],
  "preset" : "best",
  "recipe" : {
    "embedSubtitles" : true,
    "keepSubtitleFiles" : false,
    "subtitleFormat" : "best",
    "subtitleLanguages" : "en",
    "subtitleSleep" : 2,
    "writeAutoSubtitles" : true,
    "writeSubtitles" : true
  }
